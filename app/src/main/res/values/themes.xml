<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 主题。

  配色沿用原来那套偏暗的青黑，但补齐了 Material 3 要求的全套角色色
  （primary / surface / outline / onXxx），否则组件（Switch、Card、Dialog）
  会退回到默认蓝色，与整体不搭。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 主色：无障碍应用适合用沉稳的绿色（表示"可访问/正常"），
             而不是默认的紫色 -->
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_green_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>

        <item name="colorSecondary">@color/brand_teal</item>
        <item name="colorOnSecondary">@color/on_brand</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/on_brand</item>

        <!-- 背景 -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface_container</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- 字体：Material 3 用 Medium 字重做标题更清晰 -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.A11y.HeadlineSmall</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.A11y.TitleMedium</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.A11y.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.A11y.BodySmall</item>

        <!-- 关闭弹出动画，读屏用户不需要视觉干扰 -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="TextAppearance.A11y.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.A11y.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.A11y.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.A11y.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- 卡片：Material 3 的填充式卡片，无阴影、圆角 16dp -->
    <style name="Widget.A11y.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_container</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- 设置项的可点击行：用 Material 的 ripple 反馈 -->
    <style name="Widget.A11y.ListItem" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_container</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <!-- 开关：Material 3 的 MaterialSwitch -->
    <style name="Widget.A11y.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

</resources>
